# Serveur de chat (npm run chat ou conteneur docker compose)
PORT=3001

# Ollama : http://127.0.0.1:11434 en local, http://ollama:11434 dans Docker (réseau compose)
OLLAMA_URL=http://127.0.0.1:11434

# Doit correspondre au modèle pull (ex. ollama pull qwen2.5:3b pour un essai léger)
OLLAMA_MODEL=qwen2.5:14b

# Production (docker-compose.prod.yml + Caddy) — sur le VPS uniquement
# DOMAIN=cv.example.com
# ACME_EMAIL=toi@example.com
