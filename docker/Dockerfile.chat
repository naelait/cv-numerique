# API chat (Express + retrieval). Contexte de build = racine du repo.

FROM node:22-bookworm-slim

WORKDIR /app

COPY server/package.json server/package-lock.json ./server/
RUN npm ci --prefix server

COPY server ./server
COPY src/app/cv.data.ts src/app/persona.knowledge.ts src/app/persona.context.ts ./src/app/
COPY knowledge ./knowledge

WORKDIR /app/server

ENV PORT=3001
# Surchargé par docker-compose (nom du service « ollama » sur le réseau interne).
ENV OLLAMA_URL=http://ollama:11434
ENV OLLAMA_MODEL=qwen2.5:14b

EXPOSE 3001

# index.ts directement : pas de libération de port Windows (start.ts).
CMD ["npx", "tsx", "index.ts"]
